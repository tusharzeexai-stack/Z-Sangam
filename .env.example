# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION (PRODUCTION BACKEND)
# ==============================================================================
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Anonymous / Publishable API Key (Safe for browser / frontend usage)
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# NOTE: NEVER place SUPABASE_SERVICE_ROLE_KEY in frontend code or .env.example!
